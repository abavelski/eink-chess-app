+    match glyph {
+        Glyph::ChessWhiteKing => Some(FIRST_KING),
+        Glyph::ChessWhiteQueen => Some(FIRST_QUEEN),
+        Glyph::ChessWhiteRook => Some(FIRST_ROOK),
+        Glyph::ChessWhiteBishop => Some(FIRST_BISHOP),
+        Glyph::ChessWhiteKnight => Some(FIRST_KNIGHT),
+        Glyph::ChessWhitePawn => Some(FIRST_PAWN),
+        Glyph::ChessBlackKing => Some(SECOND_KING),
+        Glyph::ChessBlackQueen => Some(SECOND_QUEEN),
+        Glyph::ChessBlackRook => Some(SECOND_ROOK),
+        Glyph::ChessBlackBishop => Some(SECOND_BISHOP),
+        Glyph::ChessBlackKnight => Some(SECOND_KNIGHT),
+        Glyph::ChessBlackPawn => Some(SECOND_PAWN),
+        _ => None,
+    }
+}
